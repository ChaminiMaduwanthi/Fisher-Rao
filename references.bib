@article{manson2025curved,
  title   = {Curved Inference: Concern-Sensitive Geometry in Large Language
             Model Residual Streams},
  author  = {Manson, Rob},
  journal = {arXiv preprint arXiv:2507.21107},
  year    = {2025},
  month   = jul,
  note    = {[FULL] Uses G = U'U, the unembedding Gram matrix -- CONSTANT and
             state-independent, therefore identically zero intrinsic
             curvature. Measures Frenet curvature of a curve in a FLAT
             space, not curvature of the manifold, and NOT Fisher-Rao
             (omits Sigma_p entirely). kappa via 3-point central
             differences; salience S(t) = ||x_{t+1}-x_t||_G.
             LLaMA 3.2-3b: curvature/salience scale with concern
             (p=0.006, p=0.016); Gemma 3-1b weak. salience-curvature
             r = -0.89. Only 20 prompts, 7 domains; 1-3B models; NO
             behavioural validation. His own future work names "singularity
             analysis of embedding space combined with contextual
             curvature" -- i.e. this thesis. See also the Feb 2026
             consolidated framework paper in Bon View Press AIA.}
}

@article{king2026representational,
  title   = {Representational Curvature Modulates Behavioral Uncertainty in
             Large Language Models},
  author  = {King, Jack and Fedorenko, Evelina and Hosseini, Eghbal A.},
  journal = {arXiv preprint arXiv:2604.23985},
  year    = {2026},
  month   = apr,
  note    = {[FULL] MIT; Hosseini now Google DeepMind. "Contextual
             curvature" = angle between adjacent difference vectors,
             3-token backward window -- plain EUCLIDEAN, no metric.
             GPT-2 XL (48 layers), Pythia-2.8B (32 layers); LAMBADA +
             Universal Dependencies. Middle-layer curvature correlates
             with next-token entropy, r ~ 0.15 -- THE BASELINE TO BEAT
             (RQ3a). Coupling emerges during pretraining; only
             trajectory-aligned perturbations modulate entropy; curvature
             penalty reduces entropy without hurting val loss.
             Authors note effects were "small" at limited scale.}
}

