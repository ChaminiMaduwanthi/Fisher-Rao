@article{mabrok2026latent,
  title   = {Latent Semantic Manifolds in Large Language Models},
  author  = {Mabrok, Mohamed A.},
  journal = {arXiv preprint arXiv:2603.22301},
  year    = {2026},
  month   = mar,
  note    = {[FULL] THE key paper. Derives G(h) = W'(diag(p)-pp')W
             (Prop. 5.2). Defines Riemann tensor (Def. 9.1) and sectional
             curvature (Def. 9.2) but computes NEITHER -- uses local-PCA
             curvature and second fundamental form proxies instead.
             Reports curvature ~1e-5, "broadly stable across layers".
             Concedes true Riemann curvature "computationally intractable".
             Six architectures, 124M-1.5B. Hourglass intrinsic dimension,
             1-3% of ambient. Expressibility gap, slopes 0.87-1.12,
             R^2 > 0.985. No explicit limitations/future work section.
             Appears to assume tied embedding/unembedding weights.}
}

@article{wang2026fishback,
  title   = {FishBack: Pullback Fisher Geometry for Optimal Activation
             Steering in Transformers},
  author  = {Wang, Sihan and Zhao, Jiayi},
  journal = {arXiv preprint arXiv:2605.17231},
  year    = {2026},
  month   = may,
  note    = {[FULL] Same pullback Fisher metric G = J'HJ. Thm 3.3 gives the
             layer recursion G^(l) = A_l' G^(l+1) A_l with A_l = I + DF_l --
             REUSE THIS. Fisher deviates >97% from Euclidean in relative
             spectral norm on GPT-2; effective dimensionality only 2-17% of
             ambient. Recipe: Jacobian via 768 backward passes, Fisher from
             top-5000 tokens by probability mass, adaptive Tikhonov
             alpha = c*lambda_median(G). EXPLICITLY computes no Christoffel
             symbols, no Riemann tensor, no curvature -- spectra only.
             GPT-2 small only; flags Jacobian cost at larger scale.}
}

@article{zaher2026geometric,
  title   = {The Geometric Wall: Manifold Structure Predicts Layerwise
             Sparse Autoencoder Scaling Laws},
  author  = {Zaher, Eslam and Trzaskowski, Maciej and Nguyen, Quan and
             Roosta, Fred},
  journal = {arXiv preprint arXiv:2605.09887},
  year    = {2026},
  month   = may,
  note    = {[ABS] Rank bound rank G(h) <= min(N-1, rank J). CAUTION: this
             bound is NON-BINDING in our regime -- with d ~ 768 and
             N ~ 50000 it reduces to d whenever J has full column rank. It
             bites only when J is itself low-rank, i.e. for deep pullbacks
             through many residual blocks. Do NOT cite it as evidence that
             G is singular; see conditioning_check.py, which shows G is
             generically full rank and the real obstacle is conditioning.
             PDF text extraction FAILED; obtain HTML/LaTeX and re-read.}
}

