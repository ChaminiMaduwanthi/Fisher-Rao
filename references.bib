@inproceedings{zavatoneveth2025training,
  title     = {How does training shape the Riemannian geometry of neural
               network representations?},
  author    = {Zavatone-Veth, Jacob A. and Yang, Sheng and
               Rubinfien, Julian A. and Pehlevan, Cengiz},
  booktitle = {NeurIPS Workshop on Symmetry and Geometry in Neural
               Representations (NeurReps)},
  year      = {2025},
  note      = {[FULL] arXiv:2301.11375. Oral at NeurReps 2025; proceedings via
             PMLR, NOT JMLR -- an earlier draft of this bibliography had the
             venue wrong. Confirm the exact citation from OpenReview
             id=BaVIDhh7bj. THE methodological template: pullback metric
             g_munu = d_mu Phi_i d_nu Phi_i; computes volume element
             sqrt(det g) AND the Ricci scalar -- genuine intrinsic
             curvature. Index-symmetry simplification of R (CHECK whether
             it applies to the Fisher pullback). Needs activations C^k,
             k>=3: GELU/SiLU fine, ReLU problematic -- favourable for
             transformers. Handles DEGENERATE metrics via singular
             semi-Riemannian quotient M/~ with product of NON-ZERO
             eigenvalues -- directly applicable to the singular Fisher
             pullback. Volume peaks at decision boundaries, strengthening
             with depth; lazy regime static. Ricci scalar
             "computationally expensive and numerically challenging" even
             for small nets. NO transformers -- CNNs/MLPs on MNIST/CIFAR.
             Future work explicitly names extension to "pre-trained
             networks for which one does not have access to training
             classes" = a pretrained LLM. QUOTE THIS.}
}

